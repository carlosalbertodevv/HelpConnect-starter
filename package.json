{
  "name": "helpconnect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "ws": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
