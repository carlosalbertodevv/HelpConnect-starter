<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6D500">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bb_splash" />

    <LinearLayout
        android:id="@+id/connection_form"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/session_input_help"
            android:textColor="#263238"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/keyword_hint"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#F6D500"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/keyword_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:imeOptions="actionDone"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/validate_session"
            android:textColor="#263238"
            app:backgroundTint="#F6D500"
            app:strokeColor="#263238"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#263238"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#B42318"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#263238"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/session_panel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/session_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#263238"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#263238"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/screen_sharing_consent_help"
            android:textColor="#263238"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/remote_interaction_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#263238"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessibility_settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Permitir tudo"
            android:textColor="#263238"
            app:backgroundTint="#F6D500"
            app:strokeColor="#263238"
            app:strokeWidth="2dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_sharing_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/allow_screen_sharing"
            android:textColor="#263238"
            app:backgroundTint="#F6D500"
            app:strokeColor="#263238"
            app:strokeWidth="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/webrtc_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#263238"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop_sharing_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/stop_screen_sharing"
            android:textColor="#263238"
            app:backgroundTint="#F6D500"
            app:strokeColor="#263238"
            app:strokeWidth="2dp"
            android:visibility="gone"
            android:height="0dp"
            android:width="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ended_panel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_ended_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ended_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/return_home_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/return_home" />
    </LinearLayout>
</FrameLayout>
