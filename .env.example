# PostgreSQL hosted on your VPS or managed PostgreSQL provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/helpconnect?schema=public"

# Supabase project used only for operator authentication
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server
PORT=3001
APP_ORIGIN="http://localhost:5500"
PUBLIC_APP_URL="http://localhost:5500"
SESSION_TTL_MINUTES=30
