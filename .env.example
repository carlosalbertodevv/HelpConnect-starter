# Banco e autenticacao
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/helpconnect?schema=public

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Servidor
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5500
APP_ORIGINS=http://localhost:5500,http://10.0.2.2:5500
PUBLIC_APP_URL=http://localhost:5500
TRUST_PROXY=false
SESSION_TTL_MINUTES=15

# ICE
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
DEVICE_TICKET_TTL_SECONDS=300
